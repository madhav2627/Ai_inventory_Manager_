# =============================================================================
# ENVIRONMENT VARIABLES CONFIGURATION
# =============================================================================

# --- Backend Settings (Render / Local) ---
# Secret key used for cryptographic session cookie signing (Render generates automatically or set random string)
SECRET_KEY=your-random-32-character-secret-key-here

# Optional: Cloud PostgreSQL connection string (e.g. Neon, Supabase, Render PostgreSQL).
# If omitted, application uses local SQLite database.
DATABASE_URL=postgresql://username:password@ep-sample-pooler.region.neon.tech/neondb?sslmode=require

# Optional: Custom SQLite path (defaults to data/store.db if DATABASE_URL is not set)
DB_PATH=data/store.db

# Frontend domain for CORS allowance (e.g. your deployed Vercel domain)
FRONTEND_URL=https://your-inventory-app.vercel.app

# Port for backend service (Render automatically injects PORT, default is 5000)
PORT=5000

# Set to true if running behind cross-origin domain with cookies
CROSS_ORIGIN=false

# --- Frontend Settings (Vercel / Local) ---
# Base URL of the backend API (if client fetch calls talk directly to Render)
API_BASE_URL=https://your-render-backend.onrender.com
